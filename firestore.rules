rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the caller owns the specific user data tree
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check if caller is an authorized admin.
    // Primary check: Firebase Custom Claim { "role": "admin" } — set via Admin SDK backend.
    // Legacy fallbacks (isAdmin claim and Firestore admins doc) retained during transition.
    // IMPORTANT: The Flutter client cannot modify Custom Claims — only the Admin SDK can.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == "admin" ||
        request.auth.token.isAdmin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins collection: Client read permitted for auth check; write strictly disallowed from client
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // User profile document and all nested academic subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      
      // Enforce user isolation with administrative override:
      // (semesters, subjects, attendances, timetables, tasks, assignments, exams, notes, etc.)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Admin-only settings and configuration
    match /admin_settings/{document} {
      allow read, write: if isAdmin();
    }

    // Telemetry activity logs: Any authenticated user can append logs; only admins can query
    match /activity_logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Aggregated analytics summaries
    match /analytics_summaries/{summaryId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    // Default catch-all rule: Deny all unauthenticated or unscoped document access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
